{
    "name": "boring-o11y/horizon-worker-stats",
    "description": "Worker memory and CPU charts for the Laravel Horizon dashboard: what your whole worker fleet is using, over the last day.",
    "keywords": ["laravel", "horizon", "queue", "redis", "workers", "memory", "cpu"],
    "license": "MIT",
    "support": {
        "issues": "https://github.com/boring-o11y/horizon-worker-stats/issues",
        "source": "https://github.com/boring-o11y/horizon-worker-stats"
    },
    "require": {
        "php": "^8.1",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "laravel/horizon": "^5.24"
    },
    "require-dev": {
        "laravel/pint": "^1.13",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^8.14|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0",
        "predis/predis": "^2.2|^3.0"
    },
    "autoload": {
        "psr-4": {
            "BoringO11y\\HorizonWorkerStats\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BoringO11y\\HorizonWorkerStats\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "BoringO11y\\HorizonWorkerStats\\HorizonWorkerStatsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
