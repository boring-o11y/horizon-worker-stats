includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 5
    paths:
        - src
        - config
        - routes
        - tests
    ignoreErrors:
        # Larastan expects env() only in the application's config directory,
        # which for a package is Testbench's. The package's own config file
        # and the test environment setup are where env() belongs.
        -
            identifier: larastan.noEnvCallsOutsideOfConfig
            paths:
                - config/*
                - tests/TestCase.php
